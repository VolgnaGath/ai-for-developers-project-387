{
  "name": "@call-calendar/frontend",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --port 4173 --strictPort",
    "dev:e2e": "vite --port 5199 --strictPort --host 127.0.0.1",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "codegen": "openapi-typescript ../tsp-output/schema/openapi.yaml -o src/shared/api/generated.ts"
  },
  "dependencies": {
    "@mantine/core": "^8.0.0",
    "@mantine/dates": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@tanstack/react-query": "^5.0.0",
    "dayjs": "^1.11.21",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@msw/playwright": "^0.6.7",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
